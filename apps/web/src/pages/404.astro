---
import '~/styles/global.css';

export const prerender = false;

Astro.response.status = 404;

const locale: import('~/i18n/types').Locale = 'zh-CN';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Page not found · Webrex</title>
  </head>
  <body
    class="min-h-screen flex items-center justify-center px-6 py-20 antialiased"
    style="background: var(--color-bg); color: var(--color-text);"
  >
    <main class="w-full max-w-[560px] flex flex-col items-start text-left">
      <div class="mb-6">
        <a
          href="/"
          class="text-[13px] font-medium uppercase tracking-[0.15em]"
          style="color: var(--color-text-faint);"
        >
          Webrex
        </a>
      </div>

      <h1
        class="text-[40px] sm:text-[56px] font-semibold tracking-[-0.02em] leading-[1.1] mb-4"
        style="color: var(--color-text);"
      >
        Page not found
      </h1>

      <p
        class="text-[16px] md:text-[18px] leading-[1.6] mb-8"
        style="color: var(--color-text-muted);"
      >
        The page you're looking for doesn't exist or has been moved.
      </p>

      <a
        href="/lessons/l1-1"
        class="inline-flex items-center justify-center px-5 py-2.5 rounded-[var(--radius-button)] text-[14px] font-medium transition-colors"
        style="background: var(--color-accent); color: white;"
        onmouseover="this.style.background='var(--color-accent-hover)'"
        onmouseout="this.style.background='var(--color-accent)'"
      >
        Back to L1.1
      </a>
    </main>
  </body>
</html>
