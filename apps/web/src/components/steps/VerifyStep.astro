---
import { md } from '~/lib/markdown';
import VerifyCard from '../VerifyCard.tsx';
import ErrorBoundary from '../ErrorBoundary.tsx';

interface ChoiceOption {
  label: string;
  correct: boolean;
  hint?: string;
}

interface Props {
  title: string;
  prompt: string;
  tier: 'hard' | 'soft' | 'self' | 'choice';
  expectedRegex?: string;
  labCheckEndpoint?: string;
  options?: ChoiceOption[];
  revealOption?: ChoiceOption;
  nextStepHref?: string;
  lessonId: string;
  stepId: string;
}
const { title, prompt, tier, expectedRegex, labCheckEndpoint, options, revealOption, nextStepHref, lessonId, stepId } =
  Astro.props;
const promptHtml = md(prompt);
---

<article class="flex flex-col gap-5">
  <header class="flex flex-col gap-2">
    <h1 class="text-[1.75rem] leading-[1.25] font-semibold tracking-tight" style="color: var(--color-on-surface);">
      {title}
    </h1>
  </header>

  <ErrorBoundary client:load>
    <VerifyCard
      client:load
      tier={tier}
      promptHtml={promptHtml}
      expectedRegex={expectedRegex}
      labEndpoint={labCheckEndpoint}
      options={options}
      revealOption={revealOption}
      nextStepHref={nextStepHref}
      lessonId={lessonId}
      stepId={stepId}
    />
  </ErrorBoundary>
</article>
