---
import type { Locale } from '~/i18n/types';
import { t as translate } from '~/i18n';

interface Props {
  current: number;
  total: number;
  stepTitle: string;
  stepKind: string;
  locale: Locale;
}

const { current, total, stepKind, locale } = Astro.props;
const __ = (key: string) => translate(locale, key);
---

<nav class="flex flex-col gap-3 py-2">
  <div class="flex items-center gap-3">
    <span
      class="text-[11px] font-semibold uppercase tracking-wider"
      style="color: var(--color-text-faint);"
    >
      {__('stepProgress.step')} {current} / {total} · {stepKind}
    </span>
    <div class="flex-1 flex gap-1">
      {
        Array.from({ length: total }).map((_, i) => (
          <div
            class="h-1 flex-1 rounded-full transition-all"
            style={`background: ${i < current ? "var(--color-accent)" : "var(--color-border)"};`}
          />
        ))
      }
    </div>
  </div>
</nav>
