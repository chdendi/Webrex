---
import type { CollectionEntry } from 'astro:content';
import { getSocialStats } from '../data/social-stats';

interface Props {
  lessons: CollectionEntry<'lessons'>[];
  currentId: string;
  completedIds?: string[];
}

const { lessons, currentId, completedIds = [] } = Astro.props;
const completedSet = new Set(completedIds);

// Group by level
const byLevel = new Map<number, CollectionEntry<'lessons'>[]>();
for (const l of lessons) {
  const arr = byLevel.get(l.data.level) ?? [];
  arr.push(l);
  byLevel.set(l.data.level, arr);
}
for (const arr of byLevel.values()) {
  arr.sort((a, b) => a.data.sublevel - b.data.sublevel);
}
const sortedLevels = [...byLevel.entries()].sort((a, b) => a[0] - b[0]);

function levelTime(arr: CollectionEntry<'lessons'>[]): number {
  return arr.reduce((sum, l) => sum + l.data.time, 0);
}

function shortTitle(full: string): string {
  const emDashIdx = full.lastIndexOf('——');
  if (emDashIdx !== -1) return full.slice(emDashIdx + 2).trim();
  const parenIdx = full.indexOf('（');
  if (parenIdx !== -1) return full.slice(0, parenIdx).trim();
  return full.trim();
}

const totalLessons = lessons.length;
const completedCount = lessons.filter((l) => completedSet.has(l.id)).length;
const progressPct = totalLessons > 0 ? Math.round((completedCount / totalLessons) * 100) : 0;
---

<aside
  class="hidden md:flex fixed left-0 top-14 bottom-0 w-[280px] flex-col border-r overflow-y-auto"
  style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);"
>
  {/* Header card: progress summary */}
  <div class="px-4 pt-4 pb-3 border-b" style="border-color: var(--color-outline-variant);">
    <div class="flex items-center justify-between mb-1.5">
      <span class="text-[13px] font-semibold" style="color: var(--color-on-surface);">课程进度</span>
      <span class="text-[12px]" style="color: var(--color-on-surface-variant);">
        {completedCount} / {totalLessons}
      </span>
    </div>
    <div class="h-1 rounded-full overflow-hidden" style="background: var(--color-surface-container-high);">
      <div
        class="h-full rounded-full transition-all"
        style={`width: ${progressPct}%; background: var(--color-primary-container);`}
      />
    </div>
  </div>

  <nav class="flex-1 py-2">
    {
      sortedLevels.map(([level, arr]) => {
        const first = arr[0];
        return (
          <div class="px-3 py-1.5">
            {/* Group header */}
            <div
              class="flex items-center gap-2 px-2 py-1.5 text-[11px] font-semibold uppercase tracking-wider"
              style="color: var(--color-on-surface-variant);"
            >
              <span class="text-[15px]">{first.data.categoryIcon}</span>
              <span class="flex-1 truncate">L{level} {first.data.categoryName}</span>
              <span class="text-[10px] font-normal" style="color: var(--color-on-surface-faint);">
                {levelTime(arr)}m
              </span>
            </div>

            <ul class="mt-1 ml-3 border-l flex flex-col gap-0.5" style="border-color: var(--color-outline-variant);">
              {
                arr.map((lesson) => {
                  const isCurrent = lesson.id === currentId;
                  const isExtension = lesson.data.track === "extension";
                  const social = getSocialStats(lesson.id);
                  const isDone = completedSet.has(lesson.id);
                  return (
                    <li>
                      <a
                        href={`/lessons/${lesson.id}`}
                        data-lesson-id={lesson.id}
                        class:list={[
                          'group flex items-center gap-2 ml-2 pl-2 pr-2 py-1.5 rounded-md text-[13px] transition-colors',
                          isCurrent ? 'font-semibold' : 'hover:bg-[color:var(--color-surface-container-low)]',
                          isDone && 'lesson-done',
                        ]}
                        style={
                          isCurrent
                            ? "background: var(--color-secondary-container); color: var(--color-primary);"
                            : "color: var(--color-on-surface-variant);"
                        }
                      >
                        {isDone ? (
                          <span
                            class="lesson-done-dot flex-shrink-0 rounded-full flex items-center justify-center text-[10px] text-white"
                            style="background: var(--color-success); width: 16px; height: 16px;"
                          >
                            ✓
                          </span>
                        ) : (
                          <span
                            class="w-1.5 h-1.5 rounded-full flex-shrink-0"
                            style={
                              isCurrent
                                ? "background: var(--color-primary-container);"
                                : "background: var(--color-on-surface-faint); opacity: 0.5;"
                            }
                          />
                        )}
                        <span class="flex-1 truncate" title={lesson.data.title}>
                          L{lesson.data.level}.{lesson.data.sublevel} {shortTitle(lesson.data.title)}
                        </span>
                        <span class="text-[10px]" style="color: var(--color-on-surface-faint);">
                          {lesson.data.time}m
                        </span>
                        {social && (
                          <span
                            class="text-[10px] flex-shrink-0"
                            style="color: var(--color-on-surface-faint);"
                            title={`${social.completionsLast7d} completed in the past 7 days`}
                          >
                            · {social.completionsLast7d}
                          </span>
                        )}
                        {isExtension && (
                          <span
                            class="text-[9px] px-1 rounded border flex-shrink-0"
                            style="border-color: var(--color-outline-variant); color: var(--color-on-surface-faint);"
                          >
                            ext
                          </span>
                        )}
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </div>
        );
      })
    }
  </nav>

  <script is:inline>
    /**
     * Client-side fallback for guests — read completions from local store
     * and apply line-through + green check to matching sidebar items.
     */
    (function() {
      var KEY = 'webrex:progress:v1';
      try {
        var raw = localStorage.getItem(KEY);
        if (!raw) return;
        var parsed = JSON.parse(raw);
        var completions = (parsed && Array.isArray(parsed.completions)) ? parsed.completions : [];
        var done = new Set();
        completions.forEach(function(c) { if (c && typeof c.lessonId === 'string') done.add(c.lessonId); });
        document.querySelectorAll('aside a[data-lesson-id]').forEach(function(a) {
          if (a.classList.contains('lesson-done')) return;
          var id = a.getAttribute('data-lesson-id');
          if (!id || !done.has(id)) return;
          var title = a.querySelector('span.flex-1');
          if (title) {
            title.style.textDecoration = 'line-through';
            title.style.textDecorationColor = 'var(--color-on-surface-variant)';
          }
          a.style.opacity = '0.55';
          var dot = a.querySelector('span:first-child');
          if (dot) {
            dot.style.background = 'var(--color-success)';
            dot.style.opacity = '1';
            dot.style.width = '16px';
            dot.style.height = '16px';
            dot.style.borderRadius = '50%';
            dot.style.display = 'flex';
            dot.style.alignItems = 'center';
            dot.style.justifyContent = 'center';
            dot.style.fontSize = '10px';
            dot.style.color = '#fff';
            dot.textContent = '✓';
          }
        });
      } catch(e) {}
    })();
  </script>
</aside>
