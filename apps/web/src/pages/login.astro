---
import '~/styles/global.css';
import type { Locale } from '~/i18n/types';
import LoginButtons from '~/components/LoginButtons.tsx';
import { I18nProvider } from '~/components/I18nProvider.tsx';
import { getCurrentUser } from '~/lib/supabase/server';

export const prerender = false;

const next = Astro.url.searchParams.get('next') ?? '/';
const errorParam = Astro.url.searchParams.get('error');

// If the user is already signed in, bounce them to `next`.
const user = await getCurrentUser({ request: Astro.request, cookies: Astro.cookies });
if (user) {
  return Astro.redirect(next, 302);
}

function getLocaleFromRequest(request: Request): Locale {
  const cookie = request.headers.get('Cookie') ?? '';
  const match = cookie.match(/webrex_lang=([^;]+)/);
  if (match && (match[1] === 'en' || match[1] === 'zh-CN')) return match[1] as Locale;
  return 'zh-CN';
}

const locale = getLocaleFromRequest(Astro.request);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Sign in · Webrex</title>
  </head>
  <body class="min-h-screen flex items-center justify-center px-6" style="background: var(--color-bg);">
    <main class="w-full max-w-sm flex flex-col gap-8">
      <header class="flex flex-col gap-2 text-center">
        <a href="/" class="text-sm" style="color: var(--color-text-faint);">← Webrex</a>
        <h1 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text);">
          Sign in to save progress
        </h1>
        <p class="text-sm" style="color: var(--color-text-muted);">
          Track which lessons you've passed and see how you rank against other learners.
        </p>
      </header>

      <I18nProvider client:load initialLocale={locale}>
        <LoginButtons client:load next={next} initialError={errorParam} />
      </I18nProvider>

      <div class="flex flex-col items-center gap-1.5">
        <a
          href={next}
          class="text-sm underline underline-offset-4 transition-colors"
          style="color: var(--color-text-muted);"
          onmouseover="this.style.color='var(--color-text)'"
          onmouseout="this.style.color='var(--color-text-muted)'"
        >
          Continue without an account
        </a>
        <p class="text-xs" style="color: var(--color-text-faint);">
          Your progress just won't be saved.
        </p>
      </div>
    </main>
  </body>
</html>
