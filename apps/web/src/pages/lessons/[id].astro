---
import { getCollection } from 'astro:content';
import Card from '~/components/Card.astro';
import LessonHeader from '~/components/LessonHeader.astro';
import LessonLayout from '~/layouts/LessonLayout.astro';

export const prerender = false;

const { id } = Astro.params;
const allLessons = await getCollection('lessons');
allLessons.sort((a, b) => a.data.level - b.data.level || a.data.sublevel - b.data.sublevel);
const i = allLessons.findIndex((l) => l.id === id);
if (i === -1) {
  return new Response('Lesson not found', { status: 404 });
}
const lesson = allLessons[i];
const index = i + 1;
const total = allLessons.length;
const prevId = i > 0 ? allLessons[i - 1].id : undefined;
const nextId = i < allLessons.length - 1 ? allLessons[i + 1].id : undefined;
const d = lesson.data;

// If the lesson has steps, redirect to the first one
if (d.steps && d.steps.length > 0) {
  return Astro.redirect(`/lessons/${lesson.id}/${d.steps[0].slug}`, 302);
}
---

<LessonLayout
  current={lesson}
  allLessons={allLessons}
  prevId={prevId}
  nextId={nextId}
  index={index}
  total={total}
>
  <LessonHeader lesson={lesson} />

  <Card title="Coming soon" icon="🚧">
    <p class="text-base leading-relaxed" style="color: var(--color-text-muted);">
      这一关在路线图里，但内容还没写。<strong>L1.1</strong> 是 MVP 优先项，已经能完整跑通——
      点侧栏的 L1.1 看一下当前的学习体验长什么样。
    </p>
    <p class="text-sm" style="color: var(--color-text-faint);">
      Phase 1 会把 L1–L3 共 14 关全部写完；Phase 2+ 才会推进其他章节。
    </p>
  </Card>
</LessonLayout>
