---
import { mdGlossary as md } from '~/lib/markdown';
import Shortcut from '../Shortcut.astro';

interface ShortcutItem {
  label: string;
  mac: string;
  win: string;
}
interface Props {
  title: string;
  intro?: string;
  steps: string[];
  shortcuts?: ShortcutItem[];
  expectedOutcome?: string;
  labUrl?: string;
  externalSite?: string;
  lessonId?: string;
  stepSlug?: string;
}
const { title, intro, steps, shortcuts, expectedOutcome, labUrl, externalSite, lessonId, stepSlug } = Astro.props;
---

<article class="flex flex-col gap-7">
  <header class="flex flex-col gap-3">
    <h1 class="text-[2.25rem] leading-[1.2] font-semibold tracking-tight" style="color: var(--color-text);">
      {title}
    </h1>
    {intro && (
      <div
        class="prose-step text-[1.0625rem] leading-[1.75]"
        style="color: var(--color-text-muted);"
        set:html={md(intro)}
      />
    )}
  </header>

  {shortcuts && shortcuts.length > 0 && (
    <div
      class="rounded-2xl p-4 flex flex-col gap-3"
      style="background: var(--color-surface-muted);"
    >
      <div class="text-[10px] font-semibold uppercase tracking-wider" style="color: var(--color-text-faint);">
        Keyboard shortcuts you'll use
      </div>
      {shortcuts.map((s) => (
        <div class="flex items-center gap-3 flex-wrap">
          <span class="text-sm font-medium min-w-[160px]" style="color: var(--color-text);">{s.label}</span>
          <Shortcut mac={s.mac} win={s.win} />
        </div>
      ))}
    </div>
  )}

  {externalSite && (
    <>
    <button
      type="button"
      class="inline-flex items-center gap-3 px-6 py-3.5 text-base font-semibold text-white w-fit transition-all hover:shadow-lg active:scale-[0.98] rounded-2xl"
      style="background: linear-gradient(135deg, var(--color-accent), #005BB5); box-shadow: 0 4px 20px rgba(0,113,227,0.3);"
      id="launch-external-btn"
      data-site={externalSite}
    >
      <span class="text-xl">🌐</span>
      <span>Open {externalSite}</span>
      <span class="text-lg opacity-70">↗</span>
    </button>
    <script>
      // @ts-nocheck
      (function() {
        var btn = document.getElementById('launch-external-btn');
        if (!btn) return;
        var site = btn.getAttribute('data-site');
        var url = 'https://' + site + '/';

        btn.addEventListener('click', function() {
          window.__webrexOpenGuide = true;

          // Call PiP FIRST — window.open() consumes user activation
          var dpip = documentPictureInPicture;
          if (dpip && dpip.requestWindow) {
            dpip.requestWindow({ width: 380, height: 480 }).then(function(w) {
              window.__webrexPiPWindow = w;
              if (window.__webrexOpenGuideFn) {
                window.__webrexOpenGuideFn();
              }
            }).catch(function(e) {
              console.warn('PiP failed:', e.message || e);
              fallback();
            });
          } else {
            fallback();
          }

          // Open external site (after PiP call to preserve user activation)
          window.open(url, '_blank', 'noopener');

          function fallback() {
            if (window.__webrexOpenGuideFn) {
              window.__webrexOpenGuideFn();
            } else {
              window.dispatchEvent(new CustomEvent('webrex:open-guide'));
            }
          }
        });
      })();
    </script>
    </>
  )}

  <ol class="flex flex-col gap-5 list-none p-0 m-0">
    {steps.map((s, i) => (
      <li class="flex gap-4">
        <div
          class="shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold mt-0.5"
          style="background: var(--color-accent); color: white;"
        >
          {i + 1}
        </div>
        <div
          class="prose-step flex-1 text-[1.0625rem] leading-[1.75] pt-0.5"
          style="color: var(--color-text);"
          set:html={md(s)}
        />
      </li>
    ))}
  </ol>

  {labUrl && (
    <a
      href={labUrl}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-white w-fit transition-all hover:shadow-md"
      style="background: var(--color-accent); border-radius: var(--radius-button);"
    >
      Open demo lab page ↗
    </a>
  )}

  {expectedOutcome && (
    <div
      class="rounded-2xl p-5 mt-2"
      style="background: var(--color-surface-muted); border-left: 3px solid var(--color-success);"
    >
      <div class="text-[10px] font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-faint);">
        你应该看到
      </div>
      <div
        class="prose-step text-[0.97rem] leading-[1.65]"
        style="color: var(--color-text);"
        set:html={md(expectedOutcome)}
      />
    </div>
  )}
</article>
