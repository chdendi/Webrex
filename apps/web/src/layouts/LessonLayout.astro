---
import '~/styles/global.css';
import type { CollectionEntry } from 'astro:content';
import ProgressSync from '~/components/ProgressSync.tsx';
import Sidebar from '~/components/Sidebar.astro';
import TopNav from '~/components/TopNav.astro';
import { getCompletedLessonIdsForUser } from '~/lib/progress';
import { getCurrentUser } from '~/lib/supabase/server';

interface Props {
  current: CollectionEntry<'lessons'>;
  allLessons: CollectionEntry<'lessons'>[];
  prevId?: string;
  nextId?: string;
  index: number;
  total: number;
  locale?: import('~/i18n/types').Locale;
  hasRightRail?: boolean;
}

const { current, allLessons, prevId, nextId, index, total, locale = 'zh-CN', hasRightRail = false } = Astro.props;
const data = current.data;
const pageTitle = `L${data.level}.${data.sublevel} ${data.title} · Webrex`;
const htmlLang = locale;

const currentUser = await getCurrentUser({ request: Astro.request, cookies: Astro.cookies });
const completedIds = currentUser ? await getCompletedLessonIdsForUser(currentUser.id) : [];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <script>
      (function () {
        var p = navigator.platform || '';
        document.documentElement.setAttribute('data-os', /Mac/i.test(p) ? 'mac' : 'win');
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <TopNav
      breadcrumb={`L${data.level} ${data.categoryName} ▸ L${data.level}.${data.sublevel}`}
      progressIndex={index}
      progressTotal={total}
      locale={locale}
    />

    <div class="flex flex-1 pt-14 h-screen overflow-hidden">
      <Sidebar lessons={allLessons} currentId={current.id} completedIds={completedIds} />

      {hasRightRail ? (
        <main class="flex-1 md:ml-[280px] flex overflow-hidden">
          {/* Middle column: scrollable doc */}
          <div class="flex-1 overflow-y-auto px-8 py-10 border-r" style="border-color: var(--color-outline-variant); background: var(--color-surface-container-lowest);">
            <div class="w-full max-w-[680px] mx-auto flex flex-col gap-7">
              <slot />
            </div>
          </div>
          {/* Right rail: 420px sticky demo */}
          <aside class="hidden lg:flex w-[420px] flex-shrink-0 flex-col bg-[color:var(--color-surface-container-lowest)] overflow-hidden">
            <slot name="right-rail" />
          </aside>
        </main>
      ) : (
        <main class="flex-1 md:ml-[280px] overflow-y-auto px-6 py-12 flex justify-center">
          <div class="w-full max-w-[720px] flex flex-col gap-7">
            <slot />
          </div>
        </main>
      )}
    </div>

    {currentUser && (
      <Fragment>
        <script is:inline set:html={`window.__webrexUser = ${JSON.stringify({ id: currentUser.id })};`} />
        <ProgressSync client:idle />
      </Fragment>
    )}
  </body>
</html>
