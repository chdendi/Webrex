---
import { mdGlossary as md, mdInlineGlossary as mdInline } from '~/lib/markdown';

interface BulletItem {
  emoji?: string;
  title: string;
  body?: string;
}
interface Props {
  title: string;
  hook?: string;
  body: string[];
  bullets?: BulletItem[];
  takeaway?: string;
  nextHref?: string;
  nextLabel?: string;
}
const { title, hook, body, bullets, takeaway, nextHref, nextLabel } = Astro.props;
---

<article class="flex flex-col gap-7">
  <h1 class="text-[2rem] leading-[1.2] font-semibold tracking-tight" style="color: var(--color-on-surface);">
    {title}
  </h1>

  {hook && (
    <div
      class="prose-step text-[1.05rem] leading-[1.65] pl-4 border-l-4 italic"
      style="color: var(--color-on-surface); border-color: var(--color-primary-container);"
      set:html={md(hook)}
    />
  )}

  <div class="flex flex-col gap-4">
    {body.map((p) => (
      <div
        class="prose-step text-[1rem] leading-[1.7]"
        style="color: var(--color-on-surface);"
        set:html={md(p)}
      />
    ))}
  </div>

  {bullets && bullets.length > 0 && (
    <div class="grid gap-3 mt-2 sm:grid-cols-3">
      {bullets.map((b) => (
        <div
          class="rounded-xl border p-4 flex flex-col gap-2 transition-shadow hover:shadow-sm"
          style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);"
        >
          {b.emoji && <span class="text-3xl leading-none">{b.emoji}</span>}
          <div class="text-base font-semibold" style="color: var(--color-on-surface);">{b.title}</div>
          {b.body && (
            <div
              class="prose-step text-sm leading-relaxed"
              style="color: var(--color-on-surface-variant);"
              set:html={mdInline(b.body)}
            />
          )}
        </div>
      ))}
    </div>
  )}

  {takeaway && (
    <div
      class="rounded-xl p-4 mt-2"
      style="background: var(--color-surface-container-low); border-left: 3px solid var(--color-primary-container);"
    >
      <div class="text-[10px] font-semibold uppercase tracking-wider mb-2" style="color: var(--color-on-surface-faint);">
        Takeaway
      </div>
      <div
        class="prose-step text-[0.95rem] leading-[1.65]"
        style="color: var(--color-on-surface);"
        set:html={md(takeaway)}
      />
    </div>
  )}

  {nextHref && (
    <div class="flex justify-end pt-4 mt-2 border-t" style="border-color: var(--color-outline-variant);">
      <a
        href={nextHref}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md text-sm font-semibold transition-all hover:brightness-110"
        style="background: var(--color-primary-container); color: var(--color-on-primary);"
      >
        {nextLabel || 'Continue'} →
      </a>
    </div>
  )}
</article>
