---
import type { CollectionEntry } from "astro:content";
interface Props { lesson: CollectionEntry<"lessons"> }
const { lesson } = Astro.props;
const d = lesson.data;

const vStep = d.steps?.find((s: any) => s.type === "verify");
const tier = vStep ? (vStep as any).tier : "soft";
const tierLabel = ({ hard: "hard verify", soft: "soft verify", self: "self-check" } as Record<string, string>)[tier] || "soft verify";
const trackLabel = d.track === "extension" ? "extension" : "core";
---

<section class="flex flex-col gap-3">
  <h1 class="text-3xl font-semibold tracking-tight" style="color: var(--color-text);">
    L{d.level}.{d.sublevel} {d.title}
  </h1>
  <div class="flex flex-wrap gap-2">
    <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded text-xs border"
          style="border-color: var(--color-border); color: var(--color-text-muted);">
      ⏱ {d.time} min
    </span>
    <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded text-xs border"
          style="border-color: var(--color-border); color: var(--color-text-muted);">
      ✓ {tierLabel}
    </span>
    <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded text-xs border"
          style={`border-color: var(--color-border); color: ${d.track === "core" ? "var(--color-text-muted)" : "var(--color-warning)"};`}>
      ★ {trackLabel}
    </span>
    <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded text-xs border"
          style={d.needsLab
            ? "border-color: var(--color-accent); color: var(--color-accent);"
            : "border-color: var(--color-border); color: var(--color-text-muted);"}>
      🧪 {d.needsLab ? "needs lab" : "no lab"}
    </span>
  </div>
</section>
