---
interface Props {
  title?: string;
  icon?: string;
  numeral?: string;
  class?: string;
}
const { title, icon, numeral, class: extra = '' } = Astro.props;
---

<section
  class={`border p-6 flex flex-col gap-5 ${extra}`}
  style="background: var(--color-surface); border-color: var(--color-border); border-radius: var(--radius-card); box-shadow: var(--shadow-card);"
>
  {(title || numeral) && (
    <header class="flex items-center gap-2">
      {numeral && (
        <span class="text-xs font-mono" style="color: var(--color-text-faint);">{numeral}</span>
      )}
      {icon && <span class="text-xl">{icon}</span>}
      {title && <h2 class="text-lg font-semibold" style="color: var(--color-text);">{title}</h2>}
    </header>
  )}
  <slot />
</section>
