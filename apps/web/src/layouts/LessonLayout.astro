---
import '~/styles/global.css';
import type { CollectionEntry } from 'astro:content';
import Sidebar from '~/components/Sidebar.astro';
import TopNav from '~/components/TopNav.astro';

interface Props {
  current: CollectionEntry<'lessons'>;
  allLessons: CollectionEntry<'lessons'>[];
  prevId?: string;
  nextId?: string;
  index: number;
  total: number;
  locale?: import('~/i18n/types').Locale;
}

const { current, allLessons, prevId, nextId, index, total, locale = 'zh-CN' } = Astro.props;
const data = current.data;
const pageTitle = `L${data.level}.${data.sublevel} ${data.title} · Webrex`;
const htmlLang = locale;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <script>
      (function () {
        var p = navigator.platform || '';
        document.documentElement.setAttribute('data-os', /Mac/i.test(p) ? 'mac' : 'win');
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <TopNav
      breadcrumb={`L${data.level} ${data.categoryName} ▸ L${data.level}.${data.sublevel}`}
      progressIndex={index}
      progressTotal={total}
      locale={locale}
    />

    <div class="flex flex-1 pt-14 pb-16">
      <Sidebar lessons={allLessons} currentId={current.id} />

      <main
        class="flex-1 md:ml-[280px] px-6 py-12 flex justify-center"
      >
        <div class="w-full max-w-[680px] flex flex-col gap-8">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
