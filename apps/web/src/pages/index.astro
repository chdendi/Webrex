---
import '~/styles/global.css';
import { getAllLessonsSorted } from '~/lib/lessons';
export const prerender = true;

const locale: import('~/i18n/types').Locale = 'zh-CN';
const allLessons = await getAllLessonsSorted();
const firstLessonId = allLessons[0]?.id ?? 'l0-1';
const orderedIds = allLessons.map((l) => l.id);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Webrex — You can't out-prompt what you can't see</title>
    <meta
      name="description"
      content="A curriculum on mastering the DevTools as your primary sensory organ, and AI as your secondary brain."
    />
  </head>
  <body
    class="min-h-screen flex items-center justify-center px-6 py-20 antialiased"
    style="background: var(--color-bg); color: var(--color-text);"
  >
    <main class="w-full max-w-[720px] flex flex-col items-start text-left">
      <div class="mb-8">
        <span
          class="text-[13px] font-medium uppercase tracking-[0.15em]"
          style="color: var(--color-text-faint);"
        >
          Webrex
        </span>
      </div>

      <h1
        class="text-[40px] sm:text-[56px] md:text-[72px] font-semibold tracking-[-0.02em] leading-[1.1] mb-6 md:mb-8"
        style="color: var(--color-text);"
      >
        You can't out‑prompt what you can't see.
      </h1>

      <p
        class="text-[18px] md:text-[20px] leading-[1.6] max-w-[560px] mb-10 md:mb-12"
        style="color: var(--color-text-muted);"
      >
        A curriculum on mastering the DevTools as your primary sensory organ,
        and AI as your secondary brain.
      </p>

      <div class="w-full max-w-[320px] sm:max-w-none flex">
        <a
          id="start-cta"
          href={`/lessons/${firstLessonId}`}
          data-default-href={`/lessons/${firstLessonId}`}
          class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 rounded-[var(--radius-button)] text-[14px] font-medium transition-colors"
          style="background: var(--color-accent); color: white;"
          onmouseover="this.style.background='var(--color-accent-hover)'"
          onmouseout="this.style.background='var(--color-accent)'"
        >
          Start the first lesson
        </a>
      </div>
    </main>

    <script is:inline define:vars={{ orderedIds }}>
      (function () {
        var KEY = 'webrex:progress:v1';
        var cta = document.getElementById('start-cta');
        if (!cta || !Array.isArray(orderedIds) || orderedIds.length === 0) return;
        try {
          var raw = localStorage.getItem(KEY);
          if (!raw) return;
          var parsed = JSON.parse(raw);
          var completions = parsed && Array.isArray(parsed.completions) ? parsed.completions : [];
          if (completions.length === 0) return;
          var done = new Set();
          completions.forEach(function (c) {
            if (c && typeof c.lessonId === 'string') done.add(c.lessonId);
          });
          var nextId = null;
          for (var i = 0; i < orderedIds.length; i++) {
            if (!done.has(orderedIds[i])) {
              nextId = orderedIds[i];
              break;
            }
          }
          if (nextId && nextId !== cta.getAttribute('data-default-href').split('/').pop()) {
            cta.setAttribute('href', '/lessons/' + nextId);
          } else if (!nextId) {
            cta.setAttribute('href', '/lessons/' + orderedIds[orderedIds.length - 1]);
            cta.textContent = 'Review the last lesson';
          }
        } catch (e) {}
      })();
    </script>
  </body>
</html>
