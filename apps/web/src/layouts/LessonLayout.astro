---
import '~/styles/global.css';
import type { CollectionEntry } from 'astro:content';
import ProgressSync from '~/components/ProgressSync.tsx';
import Sidebar from '~/components/Sidebar.astro';
import TopNav from '~/components/TopNav.astro';
import { getCompletedLessonIdsForUser } from '~/lib/progress';
import { getCurrentUser } from '~/lib/supabase/server';

interface Props {
  current: CollectionEntry<'lessons'>;
  allLessons: CollectionEntry<'lessons'>[];
  prevId?: string;
  nextId?: string;
  index: number;
  total: number;
  locale?: import('~/i18n/types').Locale;
  hasRightRail?: boolean;
}

const { current, allLessons, prevId, nextId, index, total, locale = 'zh-CN', hasRightRail = false } = Astro.props;
const data = current.data;
const pageTitle = `L${data.level}.${data.sublevel} ${data.title} · Webrex`;
const htmlLang = locale;

const currentUser = await getCurrentUser({ request: Astro.request, cookies: Astro.cookies });
const completedIds = currentUser ? await getCompletedLessonIdsForUser(currentUser.id) : [];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <script>
      (function () {
        var p = navigator.platform || '';
        document.documentElement.setAttribute('data-os', /Mac/i.test(p) ? 'mac' : 'win');
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <TopNav
      breadcrumb={`L${data.level} ${data.categoryName} ▸ L${data.level}.${data.sublevel}`}
      progressIndex={index}
      progressTotal={total}
      locale={locale}
    />

    <div class="flex flex-1 pt-14 h-screen overflow-hidden">
      <Sidebar lessons={allLessons} currentId={current.id} completedIds={completedIds} />

      {hasRightRail ? (
        <main class="flex-1 md:ml-[280px] flex overflow-hidden">
          {/* Middle column: scrollable doc */}
          <div class="flex-1 overflow-y-auto px-8 py-10 border-r" style="border-color: var(--color-outline-variant); background: var(--color-surface-container-lowest);">
            <div class="w-full max-w-[680px] mx-auto flex flex-col gap-7">
              <slot />
            </div>
          </div>
          {/* Right rail: 420px sticky demo */}
          <aside class="hidden lg:flex w-[420px] flex-shrink-0 flex-col bg-[color:var(--color-surface-container-lowest)] overflow-hidden">
            <slot name="right-rail" />
          </aside>
        </main>
      ) : (
        <main class="flex-1 md:ml-[280px] overflow-y-auto px-6 py-12 flex justify-center">
          <div class="w-full max-w-[720px] flex flex-col gap-7">
            <slot />
          </div>
        </main>
      )}
    </div>

    {currentUser && (
      <Fragment>
        <script is:inline set:html={`window.__webrexUser = ${JSON.stringify({ id: currentUser.id })};`} />
        <ProgressSync client:idle />
      </Fragment>
    )}

    <script is:inline>
      (function () {
        if (window.__webrexGlossaryInit) return;
        window.__webrexGlossaryInit = true;

        var popup = null;
        var openTrigger = null;

        function slugFor(term) {
          return term.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
        }

        function ensurePopup() {
          if (popup) return popup;
          popup = document.createElement('div');
          popup.className = 'glossary-popup';
          popup.setAttribute('role', 'dialog');
          popup.setAttribute('aria-live', 'polite');
          popup.innerHTML =
            '<div class="glossary-popup__head">' +
              '<span class="glossary-popup__term"></span>' +
              '<span class="glossary-popup__fullname"></span>' +
            '</div>' +
            '<div class="glossary-popup__def"></div>' +
            '<a class="glossary-popup__link" href="#">在词典里查看 →</a>';
          document.body.appendChild(popup);
          popup.addEventListener('click', function (e) { e.stopPropagation(); });
          return popup;
        }

        function position(trigger) {
          var p = ensurePopup();
          var rect = trigger.getBoundingClientRect();
          var pRect = p.getBoundingClientRect();
          var gap = 8;
          var margin = 8;
          var left = rect.left + rect.width / 2 - pRect.width / 2;
          var top = rect.bottom + gap;
          if (top + pRect.height > window.innerHeight - margin) {
            top = rect.top - pRect.height - gap;
          }
          if (left < margin) left = margin;
          if (left + pRect.width > window.innerWidth - margin) {
            left = window.innerWidth - pRect.width - margin;
          }
          p.style.left = left + 'px';
          p.style.top = top + 'px';
        }

        function open(trigger) {
          var term = trigger.getAttribute('data-glossary-term') || '';
          var def = trigger.getAttribute('data-glossary-def') || '';
          var fullName = trigger.getAttribute('data-glossary-fullname') || '';
          var p = ensurePopup();
          p.querySelector('.glossary-popup__term').textContent = term;
          var fnEl = p.querySelector('.glossary-popup__fullname');
          fnEl.textContent = fullName;
          fnEl.style.display = fullName ? '' : 'none';
          p.querySelector('.glossary-popup__def').textContent = def;
          p.querySelector('.glossary-popup__link').setAttribute('href', '/glossary#' + slugFor(term));
          if (openTrigger && openTrigger !== trigger) openTrigger.removeAttribute('data-popup-open');
          openTrigger = trigger;
          trigger.setAttribute('data-popup-open', 'true');
          p.setAttribute('data-visible', 'true');
          position(trigger);
        }

        function close() {
          if (!popup) return;
          popup.removeAttribute('data-visible');
          if (openTrigger) {
            openTrigger.removeAttribute('data-popup-open');
            openTrigger = null;
          }
        }

        document.addEventListener('click', function (e) {
          var target = e.target;
          if (!(target instanceof Element)) return;
          var trigger = target.closest('.glossary');
          if (trigger) {
            e.preventDefault();
            if (openTrigger === trigger) {
              close();
            } else {
              open(trigger);
            }
            return;
          }
          if (popup && popup.contains(target)) return;
          close();
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') {
            close();
            return;
          }
          if ((e.key === 'Enter' || e.key === ' ') && e.target instanceof Element) {
            var trigger = e.target.closest('.glossary');
            if (trigger) {
              e.preventDefault();
              if (openTrigger === trigger) close();
              else open(trigger);
            }
          }
        });

        window.addEventListener('scroll', function () { if (openTrigger) position(openTrigger); }, true);
        window.addEventListener('resize', function () { if (openTrigger) position(openTrigger); });
      })();
    </script>
  </body>
</html>
