# Webrex Lab — Cloudflare Worker
# Copy this file to .env and customize for local development.
# Leave empty if using wrangler dev defaults (localhost:8787).

# Port for local dev server (used by wrangler --port flag, see package.json scripts)
# PORT=8787

# Cloudflare account ID (for `wrangler deploy`)
# CLOUDFLARE_ACCOUNT_ID=

# Cloudflare Workers KV namespace ID (if using KV for persistence)
# KV_NAMESPACE_ID=
