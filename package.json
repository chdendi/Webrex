{
	"name": "webrex",
	"version": "0.0.0",
	"private": true,
	"description": "Web + Cortex — DevTools & AI collaboration learning platform",
	"scripts": {
		"dev": "pnpm -r --parallel run dev",
		"dev:web": "pnpm --filter @webrex/web run dev",
		"dev:lab": "pnpm --filter @webrex/lab run dev",
		"build": "pnpm -r run build",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"test": "pnpm -r run test",
		"typecheck": "pnpm -r run typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"lefthook": "^2.1.6",
		"typescript": "^5.6.3"
	},
	"packageManager": "pnpm@10.33.3",
	"engines": {
		"node": ">=20"
	},
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "sharp",
      "workerd"
    ]
  }
}
