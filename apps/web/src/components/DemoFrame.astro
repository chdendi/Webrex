---
interface Props {
  url: string;
  lessonId: string;
  /** Optional short label shown in the address bar; defaults to "demo · {lessonId}" */
  label?: string;
}

const { url, lessonId, label } = Astro.props;
const addressLabel = label ?? `demo · ${lessonId}`;
---

<div class="flex flex-col h-full">
  {/* ════ Browser chrome: traffic-light + address bar ════ */}
  <div
    class="h-[44px] flex items-center px-3 border-b gap-3 shrink-0"
    style="background: var(--color-surface-container); border-color: var(--color-outline-variant);"
  >
    <div class="flex gap-1.5">
      <span class="w-3 h-3 rounded-full" style="background: #ff5f56;"></span>
      <span class="w-3 h-3 rounded-full" style="background: #ffbd2e;"></span>
      <span class="w-3 h-3 rounded-full" style="background: #27c93f;"></span>
    </div>
    <div
      class="flex-1 h-7 rounded-md flex items-center justify-center px-3 gap-1.5 text-[12px] border"
      style="background: var(--color-surface-container-lowest); color: var(--color-on-surface-variant); border-color: var(--color-outline-variant);"
    >
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2" />
        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
      </svg>
      <span class="font-mono">{addressLabel}</span>
    </div>
    <button
      id="demo-refresh"
      class="text-[12px] px-2 py-1 rounded-md flex items-center gap-1 border transition-colors hover:bg-[color:var(--color-surface-container-low)]"
      style="color: var(--color-on-surface-variant); border-color: var(--color-outline-variant); background: var(--color-surface-container-lowest);"
      title="Refresh demo"
      aria-label="Refresh demo"
    >
      ↻
    </button>
    <a
      href={url}
      target="_blank"
      rel="noopener"
      class="text-[12px] px-2 py-1 rounded-md flex items-center gap-1 border transition-colors hover:bg-[color:var(--color-surface-container-low)]"
      style="color: var(--color-on-surface-variant); border-color: var(--color-outline-variant); background: var(--color-surface-container-lowest);"
      title="Open in new tab"
      aria-label="Open in new tab"
    >
      ↗
    </a>
  </div>

  {/* ════ Sandbox banner ════ */}
  <div
    class="px-3 py-1.5 text-[11px] flex items-center gap-1.5 border-b shrink-0"
    style="background: var(--color-redact-bg); color: var(--color-redact-text); border-color: var(--color-redact-border);"
  >
    <span aria-hidden="true">⚠</span>
    这是一个隔离的 demo 沙箱，操作不会影响你的真实数据
  </div>

  {/* ════ iframe ════ */}
  <div class="flex-1 overflow-auto" style="background: var(--color-surface-container-lowest);">
    <iframe
      id="demo-iframe"
      src={url}
      title="Demo"
      scrolling="no"
      class="w-full border-0 block"
      style="height: 100%; min-height: 480px;"
    ></iframe>
  </div>

  {/* ════ Console (collapsed placeholder) ════ */}
  <button
    id="demo-console-toggle"
    class="h-9 px-3 flex items-center gap-2 border-t text-[12px] shrink-0 transition-colors hover:bg-[color:var(--color-surface-container-low)]"
    style="background: var(--color-surface-container); border-color: var(--color-outline-variant); color: var(--color-on-surface-variant);"
  >
    <span id="demo-console-chev" style="display: inline-block; transition: transform 0.15s;">▴</span>
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="4 17 10 11 4 5" />
      <line x1="12" y1="19" x2="20" y2="19" />
    </svg>
    <span>Console</span>
    <span class="ml-1 text-[10px] px-1.5 py-0.5 rounded-full" style="background: var(--color-surface-container-high); color: var(--color-on-surface-variant);">soon</span>
  </button>
</div>

<script is:inline>
  (function () {
    var iframe = document.getElementById('demo-iframe');
    var refresh = document.getElementById('demo-refresh');
    if (refresh && iframe) {
      refresh.addEventListener('click', function () {
        // eslint-disable-next-line no-self-assign
        iframe.src = iframe.src;
      });
    }
    // Auto-resize via postMessage from demo
    window.addEventListener('message', function (e) {
      if (e.data && e.data.webrexDemoHeight && iframe) {
        iframe.style.height = e.data.webrexDemoHeight + 16 + 'px';
      }
    });
    // Console toggle (visual only for now)
    var toggle = document.getElementById('demo-console-toggle');
    var chev = document.getElementById('demo-console-chev');
    if (toggle && chev) {
      var open = false;
      toggle.addEventListener('click', function () {
        open = !open;
        chev.style.transform = open ? 'rotate(180deg)' : 'rotate(0deg)';
      });
    }
  })();
</script>
