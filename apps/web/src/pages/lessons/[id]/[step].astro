---
import ErrorBoundary from '~/components/ErrorBoundary.tsx';
import HelpButton from '~/components/HelpButton.astro';
import RedactionPanel from '~/components/RedactionPanel.tsx';
import StepGuidePanel from '~/components/StepGuidePanel.tsx';
import ConceptStep from '~/components/steps/ConceptStep.astro';
import PracticeStep from '~/components/steps/PracticeStep.astro';
import VerifyStep from '~/components/steps/VerifyStep.astro';
import LessonLayout from '~/layouts/LessonLayout.astro';
import { getLessonNavContext } from '~/lib/lessons';

export const prerender = false;

const { id, step: stepSlug } = Astro.params;
const ctx = id ? await getLessonNavContext(id) : null;
if (!ctx) {
  return Astro.rewrite('/404');
}
const { lesson, allLessons, prevId, nextId, index: lessonIndex, total: totalLessons } = ctx;
const steps = lesson.data.steps;
if (!steps) {
  return Astro.rewrite('/404');
}
const stepIndex = steps.findIndex((s) => s.slug === stepSlug);
if (stepIndex === -1) {
  return Astro.rewrite('/404');
}
const step = steps[stepIndex];
const stepCount = steps.length;
const prevStep = stepIndex > 0 ? steps[stepIndex - 1] : null;
const nextStep = stepIndex < steps.length - 1 ? steps[stepIndex + 1] : null;
const isLastStep = stepIndex === steps.length - 1;

const stepKindLabel: Record<string, string> = {
  concept: 'Concept',
  practice: 'Practice',
  verify: 'Verify',
  'ask-ai': 'Ask AI',
};

const nextLessonTitle = nextId
  ? allLessons
      .find((l: any) => l.id === nextId)
      ?.data.title.split('——')[0]
      .trim()
  : undefined;

const nextStepHref = isLastStep
  ? nextId
    ? `/lessons/${nextId}`
    : undefined
  : `/lessons/${lesson.id}/${nextStep!.slug}`;

const locale = 'zh-CN' as const;
---

<LessonLayout
  current={lesson}
  allLessons={allLessons}
  prevId={prevId}
  nextId={nextId}
  index={lessonIndex}
  total={totalLessons}
>
  {step.type === "concept" && (
    <ConceptStep
      title={step.title}
      hook={step.hook}
      body={step.body}
      bullets={step.bullets}
      nextHref={nextStep ? `/lessons/${lesson.id}/${nextStep.slug}` : undefined}
      nextLabel={nextStep ? `Start ${stepKindLabel[nextStep.type].toLowerCase()}` : undefined}
    />
  )}
  {step.type === "practice" && (
    <PracticeStep
      title={step.title}
      intro={step.intro}
      steps={step.steps}
      shortcuts={step.shortcuts}
      expectedOutcome={step.expectedOutcome}
      labUrl={step.labUrl}
      externalSite={step.externalSite}
      lessonId={lesson.id}
      stepSlug={step.slug}
      nextStepHref={nextStepHref}
    />
  )}
  {step.type === "verify" && (
    <VerifyStep
      title={step.title}
      prompt={step.prompt}
      tier={step.tier}
      expectedRegex={step.expectedRegex}
      labCheckEndpoint={step.labCheckEndpoint}
      options={step.options}
      nextStepHref={nextId ? `/lessons/${nextId}` : undefined}
      lessonId={lesson.id}
      stepId={step.slug}
    />
  )}

  <ErrorBoundary client:load>
    <RedactionPanel client:load />
  </ErrorBoundary>

  {step.type === "practice" && !step.externalSite && (
    <ErrorBoundary client:load>
      <StepGuidePanel
        client:load
        steps={step.steps}
        stepTitle={step.title}
        lessonId={lesson.id}
        stepSlug={step.slug}
        externalSite={step.externalSite}
        nextStepHref={nextStepHref}
      />
    </ErrorBoundary>
  )}

  <HelpButton hint={lesson.data.stuck} />
</LessonLayout>
